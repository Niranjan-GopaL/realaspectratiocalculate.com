---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-surface-dark text-on-dark mt-auto">
  <div class="container-site py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 sm:gap-10 pb-8 sm:pb-10 border-b border-[rgba(255,255,255,0.16)]">
      <div class="sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5 mb-3">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M14 2L26 14L14 26L2 14L14 2ZM14 8L8 14L14 20L20 14L14 8Z" fill-rule="evenodd" fill="#fff"/>
            <circle cx="14" cy="14" r="2.5" fill="#ffed00"/>
          </svg>
          <span class="font-bold text-[16px] text-on-dark">AspectRatio<span class="font-normal text-[rgba(255,255,255,0.5)]">.calc</span></span>
        </div>
        <p class="text-[14px] text-[rgba(255,255,255,0.72)] leading-relaxed max-w-[320px]">
          The most comprehensive free aspect ratio calculator for designers, developers, and video professionals.
        </p>
      </div>

      <div>
        <h3 class="text-[13px] font-bold text-on-dark uppercase tracking-wider mb-4">Calculators</h3>
        <ul class="space-y-2 list-none p-0 m-0">
          <li><a href={`${base}/`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">Aspect Ratio Calculator</a></li>
          <li><a href={`${base}/social-media-aspect-ratios/`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">Social Media Ratios</a></li>
          <li><a href={`${base}/video-aspect-ratios/`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">Video Aspect Ratios</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-[13px] font-bold text-on-dark uppercase tracking-wider mb-4">Learn</h3>
        <ul class="space-y-2 list-none p-0 m-0">
          <li><a href={`${base}/how-to-calculate-aspect-ratio/`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">How to Calculate Aspect Ratio</a></li>
          <li><a href={`${base}/#faq`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">FAQ</a></li>
          <li><a href={`${base}/#presets`} class="text-[14px] text-[rgba(255,255,255,0.72)] hover:text-primary no-underline transition-colors">Common Aspect Ratios</a></li>
        </ul>
      </div>
    </div>

    <p class="text-[12px] text-[rgba(255,255,255,0.48)] pt-6 sm:pt-8">
      &copy; {year} realaspectratiocalculate.com. Free to use, no sign-up required.
    </p>
  </div>
</footer>
