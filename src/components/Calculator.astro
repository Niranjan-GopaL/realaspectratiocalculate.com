---
/*
  Four calculator modes :

  1. find-dimension  : given a ratio + one dimension, find the other
  2. find-ratio      : given W and H, output the simplified ratio
  3. resize          : given original W and H + new width (or height), find the other
  4. scale           : given original W and H + scale %, find new dimensions
*/

const favorites = [
  { ratio: '16:9',  name: 'Video',     w: 16, h: 9 },
  { ratio: '9:16',  name: 'Vertical',  w: 9,  h: 16 },
  { ratio: '1:1',   name: 'Square',    w: 1,  h: 1 },
  { ratio: '4:5',   name: 'Portrait',  w: 4,  h: 5 },
  { ratio: '21:9',  name: 'Ultrawide', w: 21, h: 9 },
  { ratio: '3:2',   name: 'DSLR',      w: 3,  h: 2 },
];

const presetGroups = [
  {
    label: 'Common',
    items: [
      { ratio: '16:9',  w: 16, h: 9 },
      { ratio: '4:3',   w: 4,  h: 3 },
      { ratio: '1:1',   w: 1,  h: 1 },
      { ratio: '9:16',  w: 9,  h: 16 },
      { ratio: '21:9',  w: 21, h: 9 },
      { ratio: '3:2',   w: 3,  h: 2 },
      { ratio: '2:1',   w: 2,  h: 1 },
      { ratio: '5:4',   w: 5,  h: 4 },
      { ratio: '16:10', w: 16, h: 10 },
    ],
  },
  {
    label: 'YouTube',
    items: [
      { ratio: '16:9', name: 'Video',  w: 16, h: 9 },
      { ratio: '9:16', name: 'Shorts', w: 9,  h: 16 },
    ],
  },
  {
    label: 'Instagram',
    items: [
      { ratio: '1:1',    name: 'Square',    w: 1,   h: 1 },
      { ratio: '4:5',    name: 'Portrait',  w: 4,   h: 5 },
      { ratio: '9:16',   name: 'Reels',     w: 9,   h: 16 },
      { ratio: '1.91:1', name: 'Landscape', w: 191, h: 100 },
    ],
  },
  {
    label: 'TikTok / Shorts',
    items: [
      { ratio: '9:16',  name: 'Vertical', w: 9, h: 16 },
      { ratio: '16:9',  name: 'Landscape', w: 16, h: 9 },
    ],
  },
  {
    label: 'X · Facebook · LinkedIn',
    items: [
      { ratio: '1.91:1', name: 'Link Card', w: 191, h: 100 },
      { ratio: '16:9',   name: 'Video',     w: 16,  h: 9 },
      { ratio: '4:5',    name: 'Portrait',  w: 4,   h: 5 },
      { ratio: '3:1',    name: 'Banner',    w: 3,   h: 1 },
    ],
  },
  {
    label: 'Cinema',
    items: [
      { ratio: '1.85:1', name: 'Flat',      w: 185, h: 100 },
      { ratio: '2.35:1', name: 'Scope',     w: 235, h: 100 },
      { ratio: '2.39:1', name: 'Anamorphic', w: 239, h: 100 },
      { ratio: '2:1',    name: 'Univisium',  w: 2,   h: 1 },
      { ratio: '4:3',    name: 'Academy',    w: 4,   h: 3 },
    ],
  },
  {
    label: 'Photo / Print',
    items: [
      { ratio: '3:2',   name: '35mm DSLR', w: 3,  h: 2 },
      { ratio: '4:5',   name: '4×5 Film',  w: 4,  h: 5 },
      { ratio: '5:7',   name: '5×7 Print', w: 5,  h: 7 },
      { ratio: '8:10',  name: '8×10 Print', w: 8, h: 10 },
      { ratio: '6:4',   name: '6×4 Print',  w: 6, h: 4 },
    ],
