---

<section class="bg-canvas dark:bg-surface-deep border border-hairline dark:border-[rgba(255,255,255,0.16)]">
  <!-- Header row : tabs + unit selector, single row at all sizes -->
  <div class="flex items-stretch border-b border-hairline dark:border-[rgba(255,255,255,0.12)]">
    <div class="flex overflow-x-auto no-scrollbar flex-1 min-w-0" role="tablist" aria-label="Calculator modes">
      {[
        { id: 'find-dimension', label: 'Find Dimension', short: 'Dim' },
        { id: 'find-ratio',     label: 'Find Ratio',     short: 'Ratio' },
        { id: 'resize',         label: 'Resize',         short: 'Resize' },
        { id: 'scale',          label: 'Scale %',        short: '%' },
      ].map((tab, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${tab.id}`}
          id={`tab-${tab.id}`}
          class={[
            "shrink-0 px-2.5 sm:px-5 py-2.5 sm:py-4 text-[12px] sm:text-[13px] font-bold leading-none transition-colors border-b-2 -mb-px whitespace-nowrap",
            i === 0
              ? "border-primary text-ink dark:text-on-dark bg-surface-soft dark:bg-surface-dark"
              : "border-transparent text-mute dark:text-[rgba(255,255,255,0.5)] hover:text-ink dark:hover:text-on-dark",
          ].join(' ')}
        >
          <span class="hidden sm:inline">{tab.label}</span>
          <span class="sm:hidden">{tab.short}</span>
        </button>
      ))}
    </div>

    <!-- Unit selector : right side, label hidden on smallest screens -->
    <div class="flex items-center gap-1.5 sm:gap-2 px-2 sm:px-4 py-1.5 sm:py-2 shrink-0 border-l border-hairline dark:border-[rgba(255,255,255,0.08)]">
      <span class="hidden sm:inline text-[10px] font-bold uppercase tracking-wider text-mute dark:text-[rgba(255,255,255,0.4)]">Unit</span>
      <div class="flex border border-hairline-strong dark:border-[rgba(255,255,255,0.24)] rounded-[var(--radius-xs)] overflow-hidden">
        {['px', 'cm', 'mm', 'in'].map((unit, i) => (
          <button
            data-unit-btn={unit}
            class={[
              "px-1.5 sm:px-2.5 py-1 text-[11px] sm:text-[12px] font-bold leading-none transition-colors",
              i === 0
                ? "bg-ink text-on-dark dark:bg-on-dark dark:text-ink"
                : "bg-transparent text-mute dark:text-[rgba(255,255,255,0.5)] hover:text-ink dark:hover:text-on-dark",
            ].join(' ')}
          >
            {unit}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="p-3 sm:p-6 md:p-8">
    <!-- Top : inputs + result, side by side on desktop, stacked on mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] xl:grid-cols-[1fr_360px] gap-4 sm:gap-6 lg:gap-8 items-start">

      <!-- LEFT : forms + presets -->
      <div>

        <!-- Panel 1 : Find Dimension -->
        <div id="panel-find-dimension" role="tabpanel" aria-labelledby="tab-find-dimension">
          <p class="hidden sm:block text-[13px] text-mute dark:text-[rgba(255,255,255,0.6)] mb-5">
            Enter a known aspect ratio and one dimension to find the other.
          </p>
          <div class="space-y-3 sm:space-y-4">
            <div class="grid grid-cols-[1fr_18px_1fr] sm:grid-cols-[1fr_24px_1fr] items-end gap-2 sm:gap-3">
              <div>
