<script>
type Mode = 'find-dimension' | 'find-ratio' | 'resize' | 'scale';
const MODES: Mode[] = ['find-dimension', 'find-ratio', 'resize', 'scale'];

// ─── Helpers ───────────────────────────────────────────────────────────────

function gcd(a: number, b: number): number {
  return b === 0 ? a : gcd(b, a % b);
}

function simplifyRatio(w: number, h: number): [number, number] {
  const d = gcd(Math.round(w), Math.round(h));
  return [Math.round(w) / d, Math.round(h) / d];
}

const NAMED_RATIOS: [string, number, number][] = [
  ['16:9 HD Widescreen',    16, 9],
  ['9:16 Vertical',          9, 16],
  ['4:3 Standard',           4, 3],
  ['1:1 Square',             1, 1],
  ['21:9 Ultrawide',         21, 9],
  ['3:2 DSLR / 35mm',        3, 2],
  ['2:1 Univisium',          2, 1],
  ['5:4 Classic Monitor',    5, 4],
  ['16:10 Widescreen',       16, 10],
  ['4:5 Portrait',           4, 5],
  ['1.91:1 Social Link',     191, 100],
  ['1.85:1 Cinema Flat',     185, 100],
  ['2.35:1 CinemaScope',     235, 100],
  ['2.39:1 Anamorphic',      239, 100],
  ['19.5:9 iPhone',          195, 90],
];

function getNamedRatio(w: number, h: number): string {
  const [sw, sh] = simplifyRatio(w, h);
  for (const [name, rw, rh] of NAMED_RATIOS) {
    if (sw === rw && sh === rh) return name;
  }
  const ratio = w / h;
  for (const [name, rw, rh] of NAMED_RATIOS) {
    if (Math.abs(ratio - rw / rh) < 0.005) return name;
  }
  return '';
}

function formatNumber(n: number, unit: string): string {
  if (unit === 'px') return String(Math.round(n));
  if (unit === 'in') return n.toFixed(3).replace(/\.?0+$/, '');
  return n.toFixed(2).replace(/\.?0+$/, '');
}

// ─── State ─────────────────────────────────────────────────────────────────

let activeMode: Mode = 'find-dimension';
let activeUnit = 'px';

// For modes that auto-fill one of two free fields, track which side the user last edited.
const lastEditedSide: Record<Mode, 'a' | 'b'> = {
  'find-dimension': 'a',
  'find-ratio': 'a',
  'resize': 'a',
  'scale': 'a',
};

// Flag : ignore input events triggered by programmatic value-setting.
let suppressInput = false;

function setVal(id: string, val: string | number) {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return;
  suppressInput = true;
  el.value = String(val);
  // Re-enable on next tick
  setTimeout(() => { suppressInput = false; }, 0);
}

function getNum(id: string): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  return el ? parseFloat(el.value) : NaN;
}

// ─── Preview ───────────────────────────────────────────────────────────────

const MAX_W = 64;
const MAX_H = 36;

function updatePreview(w: number, h: number) {
  const preview = document.getElementById('ratio-preview') as HTMLElement;
  const label = document.getElementById('preview-label') as HTMLElement;
  if (!preview || !w || !h) return;

  const [sw, sh] = simplifyRatio(w, h);
  const ratio = w / h;

  let pw: number, ph: number;
  if (ratio >= 1) {
    pw = MAX_W;
    ph = MAX_W / ratio;
    if (ph > MAX_H) { ph = MAX_H; pw = MAX_H * ratio; }
  } else {
    ph = MAX_H;
    pw = MAX_H * ratio;
    if (pw > MAX_W) { pw = MAX_W; ph = MAX_W / ratio; }
  }
  pw = Math.max(Math.round(pw), 12);
  ph = Math.max(Math.round(ph), 12);

  preview.style.width = `${pw}px`;
  preview.style.height = `${ph}px`;
  label.textContent = `${sw}:${sh}`;
}

// ─── Results ───────────────────────────────────────────────────────────────

function setResult(main: string, sub = '', named = '') {
  const rm = document.getElementById('result-main')!;
  const rs = document.getElementById('result-sub')!;
  const cb = document.getElementById('copy-btn') as HTMLElement;
  const nb = document.getElementById('result-named')!;
  rm.textContent = main;
  rs.textContent = sub;
  if (named) {
    nb.textContent = named;
    nb.classList.remove('hidden');
  } else {
    nb.classList.add('hidden');
  }
  if (main && main !== '—') {
    cb.classList.remove('hidden');
    cb.dataset.copy = main;
  } else {
    cb.classList.add('hidden');
  }
}

// ─── Calculation modes ────────────────────────────────────────────────────

function calcFindDimension() {
  const rw = getNum('fd-ratio-w');
  const rh = getNum('fd-ratio-h');
  if (!rw || !rh) { setResult('—', 'Enter ratio values'); return; }

  const side = lastEditedSide['find-dimension'];
  let w: number, h: number;

  if (side === 'a') {
    w = getNum('fd-width');
    if (!w) { setResult('—', 'Enter a width'); return; }
    h = (w / rw) * rh;
    setVal('fd-height', formatNumber(h, activeUnit));
  } else {
    h = getNum('fd-height');
    if (!h) { setResult('—', 'Enter a height'); return; }
    w = (h / rh) * rw;
    setVal('fd-width', formatNumber(w, activeUnit));
  }

  const named = getNamedRatio(rw, rh);
  setResult(
    `${formatNumber(w, activeUnit)} × ${formatNumber(h, activeUnit)} ${activeUnit}`,
    `${rw}:${rh} ratio`,
    named,
  );
  updatePreview(rw, rh);
}

function calcFindRatio() {
  const w = getNum('fr-width');
  const h = getNum('fr-height');
  if (!w || !h) { setResult('—', 'Enter width and height'); return; }
  const [sw, sh] = simplifyRatio(w, h);
  const dec = (w / h).toFixed(4).replace(/\.?0+$/, '');
  const named = getNamedRatio(w, h);
  setResult(
    `${sw} : ${sh}`,
    `From ${formatNumber(w, activeUnit)} × ${formatNumber(h, activeUnit)} ${activeUnit} · decimal ${dec}:1`,
    named,
  );
  updatePreview(w, h);
}

function calcResize() {
  const ow = getNum('rs-orig-w');
  const oh = getNum('rs-orig-h');
  if (!ow || !oh) { setResult('—', 'Enter original dimensions'); return; }

  const side = lastEditedSide['resize'];
  let nw: number, nh: number;

  if (side === 'a') {
    nw = getNum('rs-new-w');
    if (!nw) { setResult('—', 'Enter a new width'); return; }
    nh = (nw / ow) * oh;
    setVal('rs-new-h', formatNumber(nh, activeUnit));
  } else {
    nh = getNum('rs-new-h');
    if (!nh) { setResult('—', 'Enter a new height'); return; }
    nw = (nh / oh) * ow;
    setVal('rs-new-w', formatNumber(nw, activeUnit));
  }

  const named = getNamedRatio(ow, oh);
  const [sw, sh] = simplifyRatio(ow, oh);
  setResult(
    `${formatNumber(nw, activeUnit)} × ${formatNumber(nh, activeUnit)} ${activeUnit}`,
    `Scaled from ${formatNumber(ow, activeUnit)} × ${formatNumber(oh, activeUnit)} · ${sw}:${sh}`,
    named,
  );
  updatePreview(ow, oh);
}

function calcScale() {
  const w   = getNum('sc-width');
  const h   = getNum('sc-height');
  const pct = getNum('sc-pct');
  if (!w || !h || !pct) { setResult('—', 'Enter dimensions and scale %'); return; }
  const nw = w * pct / 100;
  const nh = h * pct / 100;
  const named = getNamedRatio(w, h);
  setResult(
    `${formatNumber(nw, activeUnit)} × ${formatNumber(nh, activeUnit)} ${activeUnit}`,
    `${pct}% of ${formatNumber(w, activeUnit)} × ${formatNumber(h, activeUnit)}`,
    named,
  );
  updatePreview(w, h);
}

const CALC_FNS: Record<Mode, () => void> = {
  'find-dimension': calcFindDimension,
  'find-ratio': calcFindRatio,
  'resize': calcResize,
  'scale': calcScale,
};

// ─── Tab switching ────────────────────────────────────────────────────────

function switchTab(mode: Mode) {
  activeMode = mode;
  MODES.forEach((m) => {
    const tab = document.getElementById(`tab-${m}`);
    const panel = document.getElementById(`panel-${m}`);
    const active = m === mode;
    tab?.setAttribute('aria-selected', String(active));
    tab?.classList.toggle('border-primary', active);
    tab?.classList.toggle('text-ink', active);
    tab?.classList.toggle('dark:text-on-dark', active);
    tab?.classList.toggle('bg-surface-soft', active);
    tab?.classList.toggle('dark:bg-surface-dark', active);
    tab?.classList.toggle('border-transparent', !active);
    tab?.classList.toggle('text-mute', !active);
    panel?.classList.toggle('hidden', !active);
  });
  CALC_FNS[mode]();
}

// ─── Unit switching ──────────────────────────────────────────────────────

function switchUnit(unit: string) {
  activeUnit = unit;
  document.querySelectorAll('[data-unit-btn]').forEach((btn) => {
    const el = btn as HTMLElement;
    const active = el.dataset.unitBtn === unit;
    el.classList.toggle('bg-ink', active);
    el.classList.toggle('text-on-dark', active);
    el.classList.toggle('dark:bg-on-dark', active);
    el.classList.toggle('dark:text-ink', active);
    el.classList.toggle('bg-transparent', !active);
    el.classList.toggle('text-mute', !active);
    el.classList.toggle('dark:text-[rgba(255,255,255,0.5)]', !active);
  });
  // Update labels
  document.querySelectorAll('.unit-label').forEach((el) => {
    el.textContent = `(${unit})`;
  });
  CALC_FNS[activeMode]();
}

// ─── Wiring ───────────────────────────────────────────────────────────────

document.addEventListener('DOMContentLoaded', () => {
  // Tab clicks
  MODES.forEach((m) => {
    document.getElementById(`tab-${m}`)?.addEventListener('click', () => switchTab(m));
  });

  // Unit buttons
  document.querySelectorAll('[data-unit-btn]').forEach((btn) => {
    btn.addEventListener('click', () => switchUnit((btn as HTMLElement).dataset.unitBtn!));
  });

  // Inputs : track which "side" was edited if applicable
  document.querySelectorAll<HTMLInputElement>('[data-mode]').forEach((el) => {
    el.addEventListener('input', () => {
      if (suppressInput) return;
      const mode = el.dataset.mode as Mode;
      const side = el.dataset.side as 'a' | 'b' | undefined;
      if (side) lastEditedSide[mode] = side;
      CALC_FNS[mode]();
    });
  });

  // Preset buttons : set ratio for active mode and recompute
  document.querySelectorAll<HTMLElement>('[data-preset-w]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const rw = parseFloat(btn.dataset.presetW!);
      const rh = parseFloat(btn.dataset.presetH!);
      const baseW = rw > 50 ? rw * 10 : rw * 120;
      const baseH = rh > 50 ? rh * 10 : rh * 120;

      if (activeMode === 'find-dimension') {
        setVal('fd-ratio-w', rw);
        setVal('fd-ratio-h', rh);
        if (lastEditedSide['find-dimension'] === 'a' && !getNum('fd-width')) {
          setVal('fd-width', Math.round(baseW));
        }
      } else if (activeMode === 'find-ratio') {
        setVal('fr-width', Math.round(baseW));
        setVal('fr-height', Math.round(baseH));
      } else if (activeMode === 'resize') {
        setVal('rs-orig-w', Math.round(baseW));
        setVal('rs-orig-h', Math.round(baseH));
        lastEditedSide['resize'] = 'a';
        if (!getNum('rs-new-w')) setVal('rs-new-w', Math.round(baseW / 1.5));
      } else if (activeMode === 'scale') {
        setVal('sc-width', Math.round(baseW));
        setVal('sc-height', Math.round(baseH));
      }
      CALC_FNS[activeMode]();
    });
  });

  // Copy button
  document.getElementById('copy-btn')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    const text = btn.dataset.copy ?? '';
    const labelSpan = btn.querySelector('span:last-child');
    navigator.clipboard.writeText(text).then(() => {
      if (labelSpan) labelSpan.textContent = 'Copied';
      setTimeout(() => { if (labelSpan) labelSpan.textContent = 'Copy'; }, 1500);
    });
  });

  // URL params : pre-fill from social media table links (?w=1080&h=1920)
  const params = new URLSearchParams(window.location.search);
  const urlW = params.get('w');
  const urlH = params.get('h');
  if (urlW && urlH) {
    switchTab('find-ratio');
    setVal('fr-width', urlW);
    setVal('fr-height', urlH);
    setTimeout(() => CALC_FNS['find-ratio'](), 10);
    setTimeout(() => {
      document.getElementById('result-box')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 50);
  } else {
    // Initial calculation with pre-filled defaults
    calcFindDimension();
  }
});
</script>
