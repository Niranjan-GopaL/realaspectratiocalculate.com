            <div class="grid grid-cols-[1fr_18px_1fr] sm:grid-cols-[1fr_24px_1fr] items-end gap-2 sm:gap-3">
              <div>
                <label class="block text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)] mb-1 sm:mb-1.5" for="rs-new-w">New Width <span class="unit-label">(px)</span></label>
