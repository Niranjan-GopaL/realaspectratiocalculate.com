---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const platforms = [
  {
    name: 'Instagram',
    color: '#E1306C',
    formats: [
      { format: 'Feed Square',       ratio: '1:1',   px: '1080×1080', note: 'Most engagement, safest crop' },
      { format: 'Feed Portrait',     ratio: '4:5',   px: '1080×1350', note: 'Max vertical real estate in feed' },
      { format: 'Feed Landscape',    ratio: '1.91:1',px: '1080×566',  note: 'Minimum aspect ratio' },
      { format: 'Stories / Reels',   ratio: '9:16',  px: '1080×1920', note: 'Full-screen vertical format' },
      { format: 'IGTV Cover',        ratio: '1:1.55',px: '420×654',   note: 'Visible in IGTV tab' },
    ],
  },
  {
    name: 'YouTube',
    color: '#FF0000',
    formats: [
      { format: 'Standard Video',    ratio: '16:9',  px: '1920×1080', note: 'Universal HD standard' },
      { format: '4K Video',          ratio: '16:9',  px: '3840×2160', note: 'Highest-quality master' },
      { format: 'Shorts',            ratio: '9:16',  px: '1080×1920', note: 'Full-screen vertical' },
      { format: 'Channel Banner',    ratio: '~6.2:1',px: '2560×1440', note: 'Safe zone 1546×423' },
      { format: 'Thumbnail',         ratio: '16:9',  px: '1280×720',  note: 'Min 640×360, JPG or PNG' },
    ],
  },
  {
    name: 'TikTok',
    color: '#010101',
    formats: [
      { format: 'Video Portrait',    ratio: '9:16',  px: '1080×1920', note: 'Recommended, fills entire screen' },
      { format: 'Video Landscape',   ratio: '16:9',  px: '1920×1080', note: 'Shown with black bars' },
      { format: 'Video Square',      ratio: '1:1',   px: '1080×1080', note: 'Shown with black bars' },
      { format: 'Profile Photo',     ratio: '1:1',   px: '200×200',   note: 'Displayed as circle' },
    ],
  },
  {
    name: 'X (Twitter)',
    color: '#000000',
    formats: [
      { format: 'In-stream Photo',   ratio: '16:9',  px: '1600×900',  note: 'Crops to 2:1 in timeline' },
      { format: 'Two-image Tweet',   ratio: '1:1',   px: '1200×600',  note: 'Side-by-side' },
      { format: 'Profile Photo',     ratio: '1:1',   px: '400×400',   note: 'Circle display' },
      { format: 'Header Banner',     ratio: '3:1',   px: '1500×500',  note: 'Crop varies by device' },
      { format: 'Summary Card',      ratio: '2:1',   px: '1200×600',  note: 'Min 300×157' },
    ],
  },
  {
    name: 'LinkedIn',
    color: '#0A66C2',
    formats: [
      { format: 'Post Image',        ratio: '1.91:1',px: '1200×628',  note: 'Standard link preview' },
      { format: 'Portrait Post',     ratio: '4:5',   px: '1080×1350', note: 'More vertical feed space' },
      { format: 'Company Banner',    ratio: '4:1',   px: '1128×191',  note: 'Header image' },
      { format: 'Video',             ratio: '16:9',  px: '1920×1080', note: '4:5 also common' },
      { format: 'Article Cover',     ratio: '1.91:1',px: '1200×628',  note: 'Top of article' },
    ],
  },
  {
    name: 'Pinterest',
    color: '#E60023',
    formats: [
      { format: 'Standard Pin',      ratio: '2:3',   px: '1000×1500', note: 'Recommended, no cut-off' },
      { format: 'Square Pin',        ratio: '1:1',   px: '1000×1000', note: 'Works but performs less' },
      { format: 'Long Pin (max)',    ratio: '1:2.1', px: '1000×2100', note: 'Taller pins get cut in feed' },
      { format: 'Idea Pin Video',    ratio: '9:16',  px: '1080×1920', note: 'Multi-page story format' },
    ],
  },
  {
    name: 'Facebook',
    color: '#1877F2',
    formats: [
      { format: 'Feed Photo',        ratio: '1.91:1',px: '1200×630',  note: 'Also renders 1:1 and 4:5' },
      { format: 'Feed Video',        ratio: '16:9',  px: '1280×720',  note: '4:5 and 1:1 also fine' },
      { format: 'Stories',           ratio: '9:16',  px: '1080×1920', note: 'Full-screen vertical' },
      { format: 'Reels',             ratio: '9:16',  px: '1080×1920', note: 'Safe zone 1080×1420' },
      { format: 'Cover Photo',       ratio: '205:78',px: '851×315',   note: '~2.7:1 desktop display' },
    ],
  },
];

// Parse first "WxH" pair from a px string : "1920×1080 / 1280×720" : returns [1920, 1080]
function parsePx(s: string): [number, number] | null {
  const m = s.match(/(\d+)\s*[×x]\s*(\d+)/);
  if (!m) return null;
  return [parseInt(m[1]), parseInt(m[2])];
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Social Media Aspect Ratios 2024. Complete Platform Guide',
  description: 'Every aspect ratio for Instagram, YouTube, TikTok, X, LinkedIn, Pinterest and Facebook with pixel dimensions and format notes.',
  url: 'https://realaspectratiocalculate.com/social-media-aspect-ratios/',
  author: { '@type': 'Organization', name: 'realaspectratiocalculate.com' },
};
---

<Layout
  title="Social Media Aspect Ratios 2024. Instagram, YouTube, TikTok and More"
  description="Complete guide to social media aspect ratios. Every ratio and pixel dimension for Instagram, YouTube, TikTok, X (Twitter), LinkedIn, Pinterest, and Facebook."
  canonical="https://realaspectratiocalculate.com/social-media-aspect-ratios/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <Header />

  <main>
    <!-- Hero : compact, professional-first -->
    <section class="bg-surface-dark text-on-dark py-10 md:py-12 border-b border-[rgba(255,255,255,0.08)]">
      <div class="container-site">
        <a href="/" class="inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-wider text-[rgba(255,255,255,0.5)] hover:text-primary mb-4 no-underline transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Back to Calculator
        </a>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
          <div>
            <h1 class="text-[clamp(1.75rem,4vw,2.5rem)] font-bold leading-[0.95] mb-2">
              Social Media Aspect Ratios
            </h1>
            <p class="text-[15px] text-[rgba(255,255,255,0.72)] max-w-[560px]">
              Every format, ratio, and pixel dimension. Updated for 2024.
            </p>
          </div>
          <a href="/" class="btn-primary self-start">Open Calculator</a>
        </div>
      </div>
    </section>

    <!-- Intro note : compact -->
    <section class="py-6 bg-canvas dark:bg-surface-dark border-b border-hairline dark:border-[rgba(255,255,255,0.08)]">
      <div class="container-site">
        <p class="text-[14px] text-mute dark:text-[rgba(255,255,255,0.6)]">
          Click any <kbd class="inline-flex items-center px-2 py-0.5 border border-hairline-strong dark:border-[rgba(255,255,255,0.32)] text-[11px] font-bold font-mono text-ink dark:text-on-dark">Try</kbd> button to send those dimensions to the calculator instantly.
        </p>
      </div>
    </section>

    {platforms.map((platform) => (
      <section class="py-12 border-b border-hairline dark:border-[rgba(255,255,255,0.08)] bg-canvas dark:bg-surface-dark">
        <div class="container-site">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-3 h-3 rounded-[var(--radius-full)]" style={`background:${platform.color}`} aria-hidden="true" />
            <h2 class="text-[22px] font-bold text-ink dark:text-on-dark">{platform.name}</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-hairline dark:border-[rgba(255,255,255,0.12)]">
                  <th class="py-2.5 pr-6 text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)]">Format</th>
                  <th class="py-2.5 pr-6 text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)]">Ratio</th>
                  <th class="py-2.5 pr-6 text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)]">Pixels</th>
                  <th class="py-2.5 pr-6 text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)]">Note</th>
                  <th class="py-2.5 text-[11px] font-bold uppercase tracking-wider text-charcoal dark:text-[rgba(255,255,255,0.5)] text-right">Action</th>
                </tr>
              </thead>
              <tbody>
                {platform.formats.map((f) => {
                  const parsed = parsePx(f.px);
                  const href = parsed ? `/?w=${parsed[0]}&h=${parsed[1]}` : '/';
                  return (
                    <tr class="border-b border-hairline dark:border-[rgba(255,255,255,0.06)] hover:bg-surface-soft dark:hover:bg-surface-deep transition-colors">
                      <td class="py-3 pr-6 text-[14px] font-bold text-ink dark:text-on-dark">{f.format}</td>
                      <td class="py-3 pr-6">
                        <span class="inline-flex items-center justify-center bg-primary text-on-primary text-[12px] font-bold px-2.5 py-1 rounded-[var(--radius-xs)]">{f.ratio}</span>
                      </td>
                      <td class="py-3 pr-6 text-[13px] text-mute dark:text-[rgba(255,255,255,0.6)] font-mono whitespace-nowrap">{f.px}</td>
                      <td class="py-3 pr-6 text-[13px] text-mute dark:text-[rgba(255,255,255,0.5)]">{f.note}</td>
                      <td class="py-3 text-right">
                        <a
                          href={href}
                          class="inline-flex items-center gap-1 px-2.5 h-[28px] text-[11px] font-bold uppercase tracking-wider leading-none border rounded-[var(--radius-xs)] bg-canvas dark:bg-surface-deep text-ink dark:text-on-dark border-hairline-strong dark:border-[rgba(255,255,255,0.24)] hover:bg-primary hover:text-on-primary hover:border-primary transition-colors no-underline"
                          aria-label={`Try ${f.px} in calculator`}
                        >
                          Try
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12"/></svg>
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    ))}

    <!-- CTA -->
    <section class="py-12 bg-primary">
      <div class="container-site flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 class="text-[1.5rem] font-bold leading-tight text-on-primary mb-1">Need to convert a dimension?</h2>
          <p class="text-[14px] text-on-primary opacity-80">Use the calculator to find any missing width or height.</p>
        </div>
        <a href="/" class="btn-dark shrink-0">Open Calculator</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
