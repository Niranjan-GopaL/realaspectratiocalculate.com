---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="404 — Page not found | RealAspectRatioCalculate"
  description="The page you're looking for doesn't exist. Head back to the aspect ratio calculator."
>
  <Header />

  <main class="flex-1 flex items-center bg-canvas dark:bg-surface-dark">
    <div class="container-site py-16 sm:py-24 md:py-32 w-full">
      <div class="max-w-2xl">
        <p class="text-[11px] sm:text-[12px] font-bold tracking-[0.18em] uppercase text-mute dark:text-[rgba(255,255,255,0.5)] mb-4">
          Error 404
        </p>
        <h1 class="text-[clamp(2.25rem,9vw,5rem)] font-bold leading-[0.95] tracking-tight text-ink dark:text-on-dark mb-5">
          This frame doesn't exist.
        </h1>
        <p class="text-[clamp(1rem,2.4vw,1.25rem)] text-body dark:text-[rgba(255,255,255,0.72)] mb-10 max-w-xl leading-relaxed">
          The page you wanted isn't here. The link may be old, or the URL might have a typo. Pick a place to land:
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={`${base}/`} class="btn-primary">Open Calculator →</a>
          <a href={`${base}/social-media-aspect-ratios/`} class="btn-outline">Social media ratios</a>
          <a href={`${base}/video-aspect-ratios/`} class="btn-outline">Video ratios</a>
          <a href={`${base}/how-to-calculate-aspect-ratio/`} class="btn-outline">How to calculate</a>
        </div>

        <div class="mt-16 flex items-center gap-4">
          <div class="h-[3px] w-12 bg-primary"></div>
          <span class="text-[11px] font-bold tracking-[0.18em] uppercase text-mute dark:text-[rgba(255,255,255,0.5)]">
            RealAspectRatioCalculate
          </span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
